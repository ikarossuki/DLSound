{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Himitsu subtitles version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "documentId", "cues"],
  "properties": {
    "format": { "const": "himitsu-subtitles" },
    "version": { "const": 1 },
    "documentId": { "$ref": "#/$defs/identifier" },
    "cues": { "type": "array", "items": { "$ref": "#/$defs/cue" } }
  },
  "$defs": {
    "identifier": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "\\S" },
    "text": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "time": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "reading": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[ぁ-ゖ゙゚ー・\\s]+$",
          "allOf": [ { "pattern": "[ぁ-ゖ]" } ]
        }
      }
    },
    "japanese": {
      "oneOf": [
        { "$ref": "#/$defs/text" },
        { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/segment" } }
      ]
    },
    "cue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "startMs"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "kind": { "enum": ["dialogue", "scene"] },
        "startMs": { "$ref": "#/$defs/time" },
        "endMs": { "$ref": "#/$defs/time" },
        "ja": { "$ref": "#/$defs/japanese" },
        "zh": { "$ref": "#/$defs/text" }
      },
      "anyOf": [ { "required": ["ja"] }, { "required": ["zh"] } ],
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "scene" } } },
          "then": {
            "required": ["endMs"],
            "properties": { "ja": { "$ref": "#/$defs/text" } }
          }
        }
      ]
    }
  }
}
